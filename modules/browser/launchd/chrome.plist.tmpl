<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>__CHROME_LABEL__</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Applications/Google Chrome.app/Contents/MacOS/Google Chrome</string>
    <string>--user-data-dir=__HOME__/__CHROME_PROFILE__</string>
    <string>--remote-debugging-port=__CHROME_PORT__</string>
    <string>--remote-debugging-address=127.0.0.1</string>
    <string>--no-first-run</string>
    <string>--no-default-browser-check</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>StandardOutPath</key><string>__HOME__/__CHROME_PROFILE__-logs/chrome.log</string>
  <key>StandardErrorPath</key><string>__HOME__/__CHROME_PROFILE__-logs/chrome.log</string>
</dict>
</plist>
